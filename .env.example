# GEMINI_API_KEY: Required for default Google Gemini AI book summaries.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional fallback API keys if using OpenAI or DeepSeek on the server side:
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
